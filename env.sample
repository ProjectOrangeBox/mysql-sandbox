# Copy to .env before running `docker compose up -d`
# (docker compose reads .env automatically)

MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=webapp
MYSQL_USER=webapp
MYSQL_PASSWORD=webapp_password
MYSQL_PORT=3306

# PDO connection details for the webapp:
#   from the host / CLI scripts:        host=127.0.0.1
#   from inside the webapp container:   host=host.docker.internal
#   DSN: mysql:host=host.docker.internal;port=3306;dbname=webapp;charset=utf8mb4
